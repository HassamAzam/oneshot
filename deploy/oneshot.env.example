# Oneshot server environment — copy to /etc/oneshot/oneshot.env, chmod 600,
# chown oneshot:oneshot. Read by:
#   - scripts/setup-server.sh --env-file /etc/oneshot/oneshot.env
#   - npm run setup -- --from-env --env-file ...   (writes /srv/oneshot/.env from it)
#   - node scripts/provision-seed.cjs --env-file ...
#   - systemd: EnvironmentFile= in deploy/systemd/*.service
# Plain KEY=value lines only: no `export`, no shell expansion, no ~ in paths
# (systemd does not expand them). A value still holding REPLACE_ME counts as unset.
# docs/SERVER-SETUP.md walks through every step.

# =============================================================== REQUIRED

# The GitLab project Oneshot works on.
GITLAB_REPO_URL=https://gitlab.arbisoft.com/arbisoft/erp
# Acting GitLab token (scope api) — whoever owns it IS this desk. setup also
# writes it as GITLAB_TOKEN, which boot requires. Prefer a bot/project token.
ONESHOT_GITLAB_TOKEN=glpat-REPLACE_ME
# Claude subscription: EITHER leave this empty and log in once as the service user
# after install (sudo -u oneshot -H claude, then /login), OR paste a token from
# `claude setup-token`. NEVER set ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN: those
# bill metered API usage and doctor fails while one is set.
CLAUDE_CODE_OAUTH_TOKEN=
# email:password of the local app user verify logs in as. provision-seed
# creates it (superuser + a linked Person) if the database lacks it.
ONESHOT_TEST_LOGIN=oneshot-test@example.com:REPLACE_ME

# --- Postgres (the app's database; setup-server.sh creates role and DB) ---
# The role needs CREATEDB: each run gets its own copy, oneshot_run_<iid>_<hex>,
# made from the baseline template below. psql runs with -w (never prompts), so
# setup-server.sh writes ~oneshot/.pgpass (mode 600) from these values.
DB_NAME=hrdb
DB_USER=oneshot
DB_PASSWORD=REPLACE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
# Per-run databases: on, copied from this template (default <DB_NAME>_baseline).
# setup-server.sh builds it once with `node scripts/app.cjs baseline --refresh
# --terminate`; per-run DBs stay off until it exists. Disk: a blocked or parked
# run keeps its copy (about one baseline each) — size the disk for that, and
# prefer a copy-on-write filesystem (XFS with reflink, or Btrfs).
ONESHOT_PER_RUN_DB=1
ONESHOT_DB_BASELINE=hrdb_baseline
# Optional: where per-run DBs live, when not the seed's DATABASES block.
# ONESHOT_RUN_DB_PG_HOST=127.0.0.1
# ONESHOT_RUN_DB_PG_PORT=5432
# ONESHOT_RUN_DB_PG_USER=oneshot
# REQUIRED on a fresh server: a dump restored into DB_NAME while it has no
# tables (never over data). ERP's migrations do not apply to an empty database —
# a data migration reads a column a later one adds — so the seed needs one.
# .sql, .sql.gz, .dump (pg_dump -Fc) or .dump.gz; the format is read from the file.
ONESHOT_DB_DUMP=/srv/dumps/REPLACE_ME.dump

# --- Redis (Celery broker + Channels layer). Run DBs use indexes 1-10 and
# local tests 15; setup-server.sh sets `databases 32` for headroom. ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Paths: explicit on a server, nothing under ~/Documents ---
# The ERP clone worktrees are cut from (provision-seed clones it if absent).
WORK_REPO=/srv/erp
# Where per-ticket worktrees go.
WT_ROOT=/srv/erp-wt
# The installed clone worktrees borrow venv/node_modules/staticfiles from.
# Normally the same as WORK_REPO.
ONESHOT_SEED_FROM=/srv/erp
# Read-only prior-art repo (write-scope denies writes under it). On a server,
# the seed clone itself.
CONTEXT_REPO=/srv/erp
# Skills/agents/rules root. Unset = the vendored /srv/oneshot/context.
# ONESHOT_SKILLS_ROOT=
# PATH phase sessions get. Unset = the conductor's PATH plus node's directory.
# ONESHOT_SESSION_PATH=/usr/local/bin:/usr/bin:/bin

# --- Concurrency and ports (sized for 10 tickets at once) ---
ONESHOT_CONCURRENCY=10
# The conductor's dev-server ports; ranges are accepted. Webpack takes +1000
# (9100-9109), so keep both ranges free. Its size caps port-bound concurrency.
PORT_POOL=8100-8109
# Django ports scripts/app.cjs leases for its own apps (webpack = port + 1000).
ONESHOT_APP_PORTS=8010-8012
# Local automation tests' app (Django, webpack); outside both ranges above.
ONESHOT_LOCAL_TESTS_PORT=8030
ONESHOT_LOCAL_TESTS_FE_PORT=9030
# App bring-ups (npm/webpack builds) allowed at the same moment.
ONESHOT_BRINGUP_PARALLEL=2
# Hosts Django accepts (hrdb/local_settings.py ALLOWED_HOSTS).
ONESHOT_APP_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Dashboard (oneshot-dashboard.service binds 0.0.0.0:8787) ---
# Required by the dashboard unit: a long random string, e.g. `openssl rand -hex 32`. It signs
# login sessions and still works as a Basic-auth password for scripts. Accounts: see SERVER-SETUP.md.
ONESHOT_DASHBOARD_TOKEN=REPLACE_ME
ONESHOT_DASHBOARD_PORT=8787
# Fleet header links to the telemetry board; setup fills it in when ONESHOT_BOARD=1.
# ONESHOT_BOARD_URL=http://<ip>:3100

# =============================================================== OPTIONAL

# --- Run window (oneshot-window.timer): <from>-<to> as hours (1-0) or clock times (HH:MM-HH:MM), or always ---
# 01:10-00:50 = all day except 20 minutes: stopped ten minutes before the 01:00 reboot so runs reach
# a checkpoint rather than being killed by it, started again ten minutes after.
ONESHOT_WINDOW=01:10-00:50

# --- Which Loop tickets this server works ---
# 1 = every ticket carrying Loop, whoever is assigned (the assignee watches the run). A ticket
# another conductor's claim note is on stays off this server, however old the note, until a
# stop note ends it; this server's own claims resume. Unset = only unassigned tickets and
# tickets assigned to this server's GitLab account.
ONESHOT_PICKUP_ANY_ASSIGNEE=1

# --- Tries a phase gets to return schema-valid output before the SDK discards the lap (default 10) ---
# MAX_STRUCTURED_OUTPUT_RETRIES=10

# --- Code review as threads on the merge request (docs/REVIEW-THREADS.md). On by default; ---
# 0 = the old loop: review cycles to implement, and merge reads findings.json.
# ONESHOT_REVIEW_THREADS=0

# --- Oneshot Board on this server (oneshot-board + oneshot-board-collector services) ---
# 1 = clone github.com/HassamAzam/oneshot-board to /srv/oneshot-board and run it on this
# server's Postgres (database BOARD_DB_NAME, owned by DB_USER) instead of Supabase. The
# database starts empty: the board records from the day it is installed.
# ONESHOT_BOARD=1
# The collector writes to that database directly, so there is no ingest token.
# Required when ONESHOT_BOARD=1 — `openssl rand -hex 32`; signs the board's login sessions.
# BOARD_SESSION_SECRET=REPLACE_ME
# BOARD_PORT=3100
# BOARD_DB_NAME=oneshot_board
# Days of transcript lines and tool bodies kept; sessions and counts are kept forever. 0 = all.
# BOARD_RETENTION_DAYS=90
# BOARD_REPO_URL=https://github.com/HassamAzam/oneshot-board.git
# Branch the board is cloned and kept on; self-host while that branch is unmerged.
# BOARD_REF=main
# Screenshots and videos the collector links in and the board serves.
# BOARD_MEDIA_DIR=/srv/oneshot-board/media
# How this server is named on the board.
# BOARD_OPERATOR=server-1

# --- Odoo (hrdb/local_settings.py; USE_ODOO turns on only when all four are set) ---
# ODOO_URL=http://REPLACE_ME:8069/xmlrpc/2
# ODOO_DB=
# ODOO_USERNAME=
# ODOO_PASSWORD=

# --- Slack (unset = status stays in the journal) ---
# SLACK_BOT_TOKEN=xoxb-REPLACE_ME
# ONESHOT_CHANNEL=
# ONESHOT_OWNER_SLACK_ID=

# --- Identity ---
# ONESHOT_OPERATOR=server-1
# ONESHOT_GIT_AUTHOR_NAME=Oneshot
# ONESHOT_GIT_AUTHOR_EMAIL=

# --- GitLab extras (see .env.example) ---
# GITLAB_READ_TOKEN=

# --- Telemetry (Langfuse) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://langfuse.arbisoft.com
# ONESHOT_OTEL_ALLOW_REMOTE=1

# --- Playwright browsers; unset = ~/.cache/ms-playwright of the oneshot user ---
# PLAYWRIGHT_BROWSERS_PATH=

# --- Python used to build the seed venv ---
# ONESHOT_PYTHON=python3.12
