# Oneshot Board collector — scans /srv/oneshot/state every 5s and posts to the local board
# (BOARD_URL in /etc/oneshot/board.env) every 60s. Installed with oneshot-board.service.
# Runs all day, not only inside ONESHOT_WINDOW, so gates answered overnight still land.
# Logs: journalctl -u oneshot-board-collector -f
[Unit]
Description=Oneshot Board collector
Documentation=file:///srv/oneshot/docs/SERVER-SETUP.md
After=oneshot-board.service
Wants=oneshot-board.service

[Service]
Type=simple
User=oneshot
Group=oneshot
WorkingDirectory=/srv/oneshot
EnvironmentFile=/etc/oneshot/oneshot.env
# Second, so its BOARD_URL (the local board) wins over any BOARD_URL in the first.
EnvironmentFile=/etc/oneshot/board.env
Environment=NO_COLOR=1
Environment=HOME=/home/oneshot
ExecStart=/usr/bin/node /srv/oneshot/scripts/board/index.mjs
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
