# Oneshot — environment template.
# cp .env.example .env && chmod 600 .env    # NEVER commit .env
#
# Every ONESHOT_* variable also accepts the legacy ONELOOP_* spelling, so an
# existing One Loop .env keeps working unchanged. ONESHOT_ wins when both are set.

# ------------------------------------------------------------------- GitLab
# Read/write PAT for arbisoft/workstreamai. Prefer a PROJECT ACCESS TOKEN
# (Settings -> Access Tokens, scope api, Developer) over your personal PAT:
# GitLab creates a bot user for it, so branches and MRs are authored by the bot
# and the token can be revoked without touching your own account.
GITLAB_TOKEN=glpat-REPLACE_ME
# Optional read-only PAT. Preferred by src/lib/gitlab.ts and by the guardrail
# hooks for their live label reads. Falls back to GITLAB_TOKEN.
GITLAB_READ_TOKEN=

# Overrides for config/project.json. Normally leave blank.
ONESHOT_GITLAB_API=
ONESHOT_GITLAB_PROJECT=
ONESHOT_PROJECT_ID=

# GitLab MCP server mounted into phase sessions. Replace with the exact output
# of `claude mcp get gitlab` so sessions use the identical server your
# interactive Claude Code uses.
GITLAB_MCP_CMD=npx
GITLAB_MCP_ARGS=-y @zereight/mcp-gitlab

# -------------------------------------------------------------------- Slack
# ONE app, ONE bot token, ONE channel (v1's seven persona apps are gone).
# Bot scopes needed: chat:write, chat:write.public, files:write, channels:history,
# channels:read, reactions:read.
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
# App-level token (xapp-, connections:write) for Socket Mode. Without it the
# listener falls back to polling conversations.history.
SLACK_APP_TOKEN=
# Channel id (C...). Overrides config/slack.json.
ONESHOT_CHANNEL=
# Your Slack user id — the @mention target for BLOCKED. Profile -> ⋮ -> Copy member ID.
ONESHOT_OWNER_SLACK_ID=

# --------------------------------------------------------------------- Paths
# Repo root override (default: resolved from the source tree). Hooks read
# ONESHOT_HOME, which the conductor sets per session automatically.
ONESHOT_HOME=
# Clone of arbisoft/workstreamai that per-ticket worktrees are cut from.
WORK_REPO=~/Documents/workstreamai
# Read-only context repo AND the source of every skill. hooks/write-scope.js
# denies all writes under this path for every phase, after realpath() — the
# worktree's .claude/ is symlinked here, so a prefix check alone would let an
# implement phase edit the skills that govern it. See docs/HOOKS.md 4.1.
CONTEXT_REPO=~/Documents/erp
ONESHOT_SKILLS_ROOT=~/Documents/erp/.claude
# Where per-ticket worktrees are created. One root per repo — worktrees from two
# different repositories in one directory make `git worktree remove` fail.
WT_ROOT=~/Documents/oneshot-wt

# --- Local-dev seeding (a fresh worktree cannot RUN without these) ---
# SEED_LINKS are symlinked (heavy, read-mostly); SEED_COPIES are copied, so a
# worktree editing its settings does not edit the seed repo's. Blank
# ONESHOT_SEED_FROM disables seeding, which costs `npm ci` minutes per worktree.
ONESHOT_SEED_FROM=~/Documents/erp
ONESHOT_SEED_LINKS=venv,node_modules
ONESHOT_SEED_COPIES=hrdb/local_settings.py,frontend/src/constants/config.js

# Dev-server port pool. Its size is the real concurrency limit for phases that
# need a port — but config/project.json concurrency must stay 1 regardless.
PORT_POOL=8000,8001,8002

# PATH handed to scrubbed sessions. Blank = derived from this process with the
# active node binary's directory guaranteed on it (portable across nvm/brew).
ONESHOT_SESSION_PATH=
# Node binary used by the guardrail hooks (default: `node` from PATH).
ONESHOT_NODE=

# -------------------------------------------------------------------- Deploy
# Phase 10. See config/deploy.json. The demo box is VPN-gated.
ONESHOT_DEPLOY_SERVER=
ONESHOT_DEMO_URL=https://ws-ai-demo.arbisoft.com
# 1 = run every phase but never invoke the deploy script. Use for the first
# real ticket, so a full run is observable without touching the demo server.
ONESHOT_SKIP_DEPLOY=

# --------------------------------------------------------- Claude auth (READ)
# Oneshot runs on a Claude MAX SUBSCRIPTION, not metered API billing. The Agent
# SDK spawns the Claude Code binary, so Claude Code's credential precedence
# applies (first match wins):
#   1. CLAUDE_CODE_USE_BEDROCK / _VERTEX / _FOUNDRY  -> cloud provider
#   2. ANTHROPIC_AUTH_TOKEN                          -> Bearer token
#   3. ANTHROPIC_API_KEY                             -> METERED API BILLING
#   4. apiKeyHelper in ~/.claude/settings.json       -> whatever it prints
#   5. CLAUDE_CODE_OAUTH_TOKEN                       -> subscription
#   6. `claude login` OAuth credential (Keychain)    -> subscription
#
# ==> DO NOT SET ANTHROPIC_API_KEY OR ANTHROPIC_AUTH_TOKEN ANYWHERE. In
#     headless/SDK mode Claude Code never prompts about a detected key — it
#     just uses it, silently turning this into a metered API bill. An EMPTY
#     value is not safe either; the variable must be ABSENT. src/lib/config.ts
#     builds session env from scratch and deletes these, and `npm run doctor`
#     refuses to pass if one is present.
#
# Nothing needs setting here if `claude login` works on this machine. Set the
# OAuth token ONLY for a headless box: `claude setup-token` mints a one-year,
# model-requests-only token. It is a CREDENTIAL — chmod 600, never commit.
CLAUDE_CODE_OAUTH_TOKEN=
# Refuse to start unless subscription auth is clean (default: warn only).
ONESHOT_REQUIRE_SUBSCRIPTION=
# The 1M-token context window draws on purchased usage credits even when
# subscription allowance remains — a real charge — so it is disabled. Set to 1
# only if you have credits and genuinely need it.
ONESHOT_ALLOW_1M_CONTEXT=

# ------------------------------------------------------------ Quota / budget
# Ceilings, per-phase shares and the reserve live in config/budgets.json (units:
# weighted tokens). These override the totals for one run:
ONESHOT_WINDOW_TOKENS=
ONESHOT_DAY_TOKENS=
# Stop claiming tickets once the ACCOUNT-WIDE 5h window is this % consumed,
# leaving the rest for you (config default 70). Only has teeth with the
# status-line harvester installed — see README.
ONESHOT_RESERVE_PCT=
ONESHOT_RATELIMIT_SIGNAL=

# ------------------------------------------------ Session tracking (Langfuse)
# Claude Code emits OpenTelemetry natively — Oneshot writes no instrumentation,
# it only puts the right variables in each phase's environment. Settings live in
# config/otel.json (endpoint, exporters, the two prompt-text flags) because
# src/lib/config.ts REPLACES the subprocess env, so an OTEL_* exported in your
# shell would be stripped like everything else. Only credentials belong here.
#
#   docker compose -f docker-compose.langfuse.yml up -d
#   open http://localhost:3000 -> create a project -> copy its API keys
#
# Mapping: session = one ticket run, trace = one phase, span = one tool call or
# subagent, generation = one model request with tokens.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Where Langfuse lives. Blank = the self-hosted stack on localhost:3000.
# Set to https://cloud.langfuse.com (or https://eu.cloud.langfuse.com) to use
# Langfuse Cloud — which ALSO requires the egress opt-in below, because spans
# carry ERP file paths, module names and command arguments.
LANGFUSE_BASE_URL=
# Full OTLP endpoint override, if you need something other than
# <LANGFUSE_BASE_URL>/api/public/otel.
ONESHOT_OTEL_ENDPOINT=
# DATA EGRESS OPT-IN. Telemetry silently disables itself when the endpoint is
# not loopback and this is unset — see config/otel.json "allowRemote". 1 = yes,
# deliberately send span metadata about a private codebase to a third party.
ONESHOT_OTEL_ALLOW_REMOTE=
# 0 disables telemetry for one run, 1 force-enables it. Blank = use the file.
ONESHOT_OTEL=
#
# NOT settable here, on purpose: OTEL_LOG_USER_PROMPTS and
# OTEL_LOG_ASSISTANT_RESPONSES. They put full prompt and response TEXT into
# spans — for Oneshot that means ticket bodies, MR diffs and repo contents,
# duplicated into a span store and rendered in a browser. They are opt-in flags
# in config/otel.json, default false. The per-phase JSONL under
# state/runs/<iid>/ is already the system of record for conversation content.

# ------------------------------------------------------------------ Toggles
# 1 = run every phase but deny every write (GitLab, git push, deploy). The way
# to watch the pipeline drive a real ticket without touching anything.
DRY_RUN=
# Comma-separated phase names to skip, e.g. demo,memorize.
ONESHOT_SKIP_PHASES=

# --- Bot identity: make the work attributable to the bot, not to you ---
# With a project access token, GitLab's bot address is on the token page and
# looks like project_1491_bot_<hash>@noreply.gitlab.arbisoft.com
ONESHOT_GIT_AUTHOR_NAME=Oneshot
ONESHOT_GIT_AUTHOR_EMAIL=
