# Oneshot — environment template.
# cp .env.example .env && chmod 600 .env    # NEVER commit .env (`npm run setup` does this for you)
#
# Fill in REQUIRED, review SET ON MOST DESKS, and leave OPTIONAL commented out
# unless you need to change a default. A value still containing REPLACE_ME
# counts as unset. Every ONESHOT_* name also accepts the legacy ONELOOP_*
# spelling; ONESHOT_ wins when both are set.
#
# GITLAB_REPO_URL replaces ONESHOT_PROJECT, ONESHOT_GITLAB_PROJECT,
# ONESHOT_GITLAB_API and ONESHOT_PROJECT_ID: delete those lines from an existing
# .env (one that disagrees with the URL refuses boot, the rest draw a doctor
# warning). Run journals left by another project are never resumed; boot and
# `npm run doctor` print the exact command that moves them aside — never
# `mv state/runs/*`, which takes this project's live runs with it.

# ================================================================== REQUIRED
# Boot refuses to start without these two.

# The GitLab project Oneshot works on — this one line decides it. Accepted:
#   https://<host>/<group>/<project>        a trailing / or .git is fine
#   git@<host>:<group>/<project>.git        or ssh://git@<host>:2222/<group>/<project>.git
#   https://<host>/<group>/<sub>/<project>  subgroups, any depth
#   https://<host>/<group>/<project>/-/issues/12   a pasted browser URL: /-/… is dropped
# Derived from it: the host, the API (https://<host>/api/v4; an SSH port is
# dropped), the project path, and the name (last segment, lower-cased: `erp`)
# that the WORK_REPO and WT_ROOT defaults use. The numeric id is asked of GitLab.
# WORK_REPO's origin must be a clone of this project, or boot and doctor refuse.
GITLAB_REPO_URL=https://gitlab.arbisoft.com/arbisoft/erp

# Read/write GitLab token for that project, scope api. Boot refuses while this
# is unset, but for acting a per-desk token outranks it: ONESHOT_GITLAB_TOKEN >
# `npm run token:set` (~/.config/oneshot/gitlab-token) > keychain > glab > this.
# Whoever owns the winning token IS this desk (GET /user): it claims only
# tickets assigned to that account, and comments, pushes and merges as it.
GITLAB_TOKEN=glpat-REPLACE_ME

# ========================================================= SET ON MOST DESKS
# Boot works without these, but a desk without them cannot run the app for
# verify or post status anywhere but its own console.

# --- Seeding: a fresh worktree cannot RUN the app without it ---
# An INSTALLED clone of the GITLAB_REPO_URL project (normally WORK_REPO) that
# every worktree borrows its gitignored pieces from. Unset = the conductor seeds
# nothing. Boot, doctor and scripts/app.cjs refuse a seed of another project.
ONESHOT_SEED_FROM=~/Documents/erp
# Symlinked (heavy, read-mostly). staticfiles is load-bearing: without it every
# {% static %} page, the readiness probe included, fails and the bring-up dies
# as E_DJANGO_DEAD. `node scripts/app.cjs ensure` collects it in the seed if missing.
ONESHOT_SEED_LINKS=venv,node_modules,staticfiles
# Copied, so a worktree editing its settings does not edit the seed's.
ONESHOT_SEED_COPIES=hrdb/local_settings.py,frontend/src/constants/config.js

# --- Slack: one app, one bot token, one channel ---
# Bot scopes: chat:write, chat:write.public, files:write, channels:history,
# channels:read, reactions:read, users:read (plus users:read.email to @mention
# reviewers by work email). Unset = status stays on the console.
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
# Channel id (C…). Overrides config/slack.json.
ONESHOT_CHANNEL=
# Your Slack member id (U…), the @mention on BLOCKED. Profile -> ⋮ -> Copy member ID.
ONESHOT_OWNER_SLACK_ID=

# --- Local app login (skills/local-browser-verify) ---
# email:password for the SPA, split on the FIRST colon so a password may contain
# one. app-env.json records only the variable NAME, never the value.
ONESHOT_TEST_LOGIN=someone@arbisoft.com:REPLACE_ME

# ================================================================== OPTIONAL
# Every line below is commented out at its default. Uncomment to change one.

# --- Paths ---
# Your clone of the GITLAB_REPO_URL project; worktrees are cut from it and its
# origin must be that project. Default derived from the URL's name.
# WORK_REPO=~/Documents/<name>
# Where per-ticket worktrees go. One root per project: worktrees are named by iid.
# WT_ROOT=~/Documents/<name>-wt
# ONESHOT_<NAME>_WORK_REPO / _WT_ROOT / _SEED_FROM (e.g. ONESHOT_ERP_WORK_REPO)
# outrank the plain names above; `npm run doctor` shows which line set each path.
# Escape hatch: turns repo-check FAILs (origin, WT_ROOT, legacy selector) into WARNs —
# never a missing GITLAB_REPO_URL, and app.cjs still refuses an app-<port> worktree of
# another clone. Boot and doctor nag while it is set.
# ONESHOT_SKIP_REPO_CHECK=1
# Read-only prior-art repo. hooks/write-scope.cjs denies every write under it.
# CONTEXT_REPO=~/Documents/erp
# Skills/agents/rules composed into each phase. Default: the vendored context/;
# point it at a live .claude (e.g. ~/Documents/erp/.claude) to let local edits win.
# ONESHOT_SKILLS_ROOT=./context

# --- GitLab ---
# Explicit acting token, above every other source (for CI). See GITLAB_TOKEN.
# ONESHOT_GITLAB_TOKEN=
# Read-only PAT used for API reads when set; writes still use the acting token.
# GITLAB_READ_TOKEN=
# GitLab MCP server for phase sessions. Leave unset: the default is the bundled
# node_modules/.bin/mcp-gitlab. Never `npx -y @zereight/mcp-gitlab` — npm is
# blocked while the VPN is up, so the phase gets no tools and burns its whole
# timeout at zero turns. `npm run deps:verify` checks for this.
# GITLAB_MCP_CMD=
# GITLAB_MCP_ARGS=

# --- Claude / sessions ---
# Oneshot runs on a Claude subscription. NEVER set ANTHROPIC_API_KEY or
# ANTHROPIC_AUTH_TOKEN anywhere (not even empty): Claude Code silently bills them
# as metered API usage. Sessions strip them and doctor fails while one is set.
# Only for a headless box with no `claude login`: a `claude setup-token` token.
# It is a credential — chmod 600, never commit.
# CLAUDE_CODE_OAUTH_TOKEN=
# 1 = refuse to boot unless subscription auth is clean (default: warn only).
# ONESHOT_REQUIRE_SUBSCRIPTION=
# The 1M-token context draws on purchased usage credits even while subscription
# allowance remains — a real charge — so it stays off unless this is 1.
# ONESHOT_ALLOW_1M_CONTEXT=
# Minutes a phase's stream may stay silent before it is aborted as stalled; 0 = off.
# ONESHOT_PHASE_IDLE_MIN=15
# Comma-separated phase names to skip, e.g. ui-evidence.
# ONESHOT_SKIP_PHASES=
# PATH for scrubbed sessions. Default: this process's PATH plus node's directory.
# ONESHOT_SESSION_PATH=
# Node binary the guardrail hooks run with. Default: the node running the conductor.
# ONESHOT_NODE=

# --- Budgets (defaults live in config/budgets.json; units: weighted tokens) ---
# Ceiling for one 5-hour window, and for one day.
# ONESHOT_WINDOW_TOKENS=
# ONESHOT_DAY_TOKENS=
# Stop claiming once the ACCOUNT-WIDE 5h window is this % used. Only has teeth
# with the status-line harvester installed (see README).
# ONESHOT_RESERVE_PCT=
# The harvester's file, as an absolute path (~ is not expanded here).
# Default: ~/.claude/state/ratelimit.json.
# ONESHOT_RATELIMIT_SIGNAL=

# --- Telemetry (Langfuse over OpenTelemetry; settings in config/otel.json) ---
# Project API keys; unset = telemetry off. Self-hosted stack:
# docker compose -f docker-compose.langfuse.yml up -d, then http://localhost:3000.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Default: the self-hosted stack on http://localhost:3000.
# LANGFUSE_BASE_URL=
# Full OTLP endpoint, when it is not <LANGFUSE_BASE_URL>/api/public/otel.
# ONESHOT_OTEL_ENDPOINT=
# DATA EGRESS OPT-IN. A non-loopback endpoint (e.g. Langfuse Cloud) stays off
# unless this is 1: spans carry ERP file paths, module names and command args.
# ONESHOT_OTEL_ALLOW_REMOTE=
# 0 = telemetry off for one run, 1 = force on. Prompt/response TEXT logging is a
# config/otel.json flag only (default off), never an env var.
# ONESHOT_OTEL=

# --- Identity & claims ---
# Commit author for pipeline work. A project access token's bot address
# (project_<id>_bot_<hash>@noreply.<host>) is shown on its token page.
# ONESHOT_GIT_AUTHOR_NAME=Oneshot
# ONESHOT_GIT_AUTHOR_EMAIL=
# Whose desk this is, on the Slack card and the claim note. Default:
# BOARD_OPERATOR, then the OS username. Deliberately not the git author.
# ONESHOT_OPERATOR=
# Domain that turns a config/reviewers.json username into a Slack @mention
# (<username>@<domain>). Default: that file's emailDomain.
# ONESHOT_REVIEWER_EMAIL_DOMAIN=
# Across machines the OLDEST live claim note owns a ticket; a fresh claim waits
# this long for a simultaneous claimant's note before it counts.
# ONESHOT_CLAIM_SETTLE_MS=15000
# A claim note with no stop note counts as live this long (a parked run waits
# days on a human). Delete a stale claim note by hand to release sooner.
# ONESHOT_CLAIM_STALE_HOURS=24

# --- Telemetry board (npm run board; npm run board:dry ships nothing) ---
# The shared board. Unset = the collector stays inert.
# BOARD_URL=
# The board's write token — the same value as INGEST_TOKEN on the deployment.
# BOARD_INGEST_TOKEN=
# Display name on the board. Default: the OS username, then the `gh` login.
# BOARD_OPERATOR=
# Collector state and outbox, as an absolute path. Default: ~/.oneshot-board.
# BOARD_STATE_DIR=
# 1 = extract but never ship.
# BOARD_DRY_RUN=
# Collector tuning: scan/flush intervals, batch/output/line size caps, and how
# long a silent phase runs before the board flags it as stalled.
# BOARD_SCAN_INTERVAL_MS=5000
# BOARD_FLUSH_INTERVAL_MS=60000
# BOARD_MAX_BATCH_BYTES=1500000
# BOARD_MAX_TOOL_OUTPUT_BYTES=512000
# BOARD_MAX_LINE_BYTES=1000000
# BOARD_STALLED_AFTER_MS=900000

# --- Dev / local app ---
# 1 = run every phase but deny every write (GitLab, push, merge), in state-dry/.
# DRY_RUN=
# The conductor's dev-server ports. Its size is the real limit on port-bound
# phases; config/project.json concurrency must stay 1 regardless.
# PORT_POOL=8000,8001,8002
# Django ports scripts/app.cjs leases for its own apps (webpack = port + 1000).
# ONESHOT_APP_PORTS=8010,8011,8012
# Pins webpack's port. Default: the Django port + 1000. A fixed value here makes
# every run's app ask for the same port, so leave it unset.
# ONESHOT_FE_PORT=
# Branch scripts/app.cjs starts on. Default: config/project.json branches.base.
# ONESHOT_BASE_BRANCH=
# Port for `npm run dashboard`.
# ONESHOT_DASHBOARD_PORT=8787
